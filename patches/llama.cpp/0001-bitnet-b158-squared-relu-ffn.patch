From bf2873bb3d1cab0e212dcf3c7c3d015ecbc381d1 Mon Sep 17 00:00:00 2001
From: Richard Spindler <richard@lateralblast.com.au>
Date: Mon, 5 Oct 2026 11:24:26 +1100
Subject: [PATCH] bitnet-b1.58: use squared-ReLU FFN (was SiLU via bitnet graph
 reuse)

BitNet b1.58-2B-4T uses ReLU^2 in its FFN, as in the old build_bitnet_158.
The b158 arch reused the 3B bitnet graph (SiLU), giving looping/garbage output.
---
 src/models/bitnet.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/models/bitnet.cpp b/src/models/bitnet.cpp
index 985c8d6fc..b269277f1 100644
--- a/src/models/bitnet.cpp
+++ b/src/models/bitnet.cpp
@@ -130,7 +130,7 @@ llama_model_bitnet::graph::graph(const llama_model & model, const llm_graph_para
                 model.layers[il].ffn_gate, NULL, model.layers[il].ffn_gate_s,
                 NULL,                      NULL, NULL,
                 NULL,
-                LLM_FFN_SILU, LLM_FFN_PAR, il);
+                model.arch == LLM_ARCH_BITNET_B158 ? LLM_FFN_RELU_SQR : LLM_FFN_SILU, LLM_FFN_PAR, il);
         cb(cur, "ffn_sub_out", il);
 
         cur = build_norm(cur,
-- 
2.53.0

