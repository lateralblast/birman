diff --git a/ggml/src/ggml-cpu/ggml-cpu-i2s.h b/ggml/src/ggml-cpu/ggml-cpu-i2s.h
index a0d336021..4a7a6bf8f 100644
--- a/ggml/src/ggml-cpu/ggml-cpu-i2s.h
+++ b/ggml/src/ggml-cpu/ggml-cpu-i2s.h
@@ -3,6 +3,25 @@
 
 #include "ggml.h"
 
+// Tail of an I2_S row. The kernels process a row in blocks of 128 elements (32 bytes each, the
+// layout dequantize_row_i2_s() documents). When n is not a multiple of 128, the last n % 128
+// elements are stored after those blocks, packed 4 per byte in order (first element in the high
+// bits), so a row is always n/4 bytes. The SIMD loops only see the full blocks (nb = n / 128);
+// this adds the tail. Codes are 0, 1, 2 (-1, 0, +1), like the SIMD path, and the caller subtracts
+// the activation sum afterwards.
+static inline int32_t ggml_i2s_tail_dot(const uint8_t * x_row, const int8_t * y, int64_t n) {
+    const int64_t t = n % 128;
+    int32_t sum = 0;
+    if (t != 0) {
+        const uint8_t * xt = x_row + (n - t) / 4;
+        const int8_t  * yt = y + (n - t);
+        for (int64_t k = 0; k < t; k++) {
+            sum += (int32_t)((xt[k >> 2] >> (6 - 2 * (k & 3))) & 3) * yt[k];
+        }
+    }
+    return sum;
+}
+
