+            const uint8_t * xb = x_row + b / 4;
+            for (int j = 0; j < 128; j++) {
+                sum += (int32_t)((xb[j % 32] >> (6 - 2 * (j / 32))) & 3) * y[b + j];
+            }
         }
+        sum += ggml_i2s_tail_dot(x_row, y, n);
