         s[row] = (float)sumi;
     }
+#elif defined(__ARM_NEON)
+    // NEON: same layout and convention as the AVX2 path. A 128-element block is 32 bytes, loaded as two
+    // 16-byte halves; bit-plane p (>> 6, >> 4, >> 2, >> 0) of half h holds elements p*32 + h*16 .. +15.
+    // The codes 0-2 fit in int8, so ggml_vdotq_s32 (sdot with DOTPROD) accumulates code * y into int32.
+    (void)bs; (void)by;
+    const uint8_t * x = (const uint8_t *)vx;
+    const int8_t  * y = (const int8_t  *)vy;
+    const int nb = n / 128;
+    const uint8x16_t mask = vdupq_n_u8(0x03);
+
+    for (int row = 0; row < nrc; row++) {
+        const uint8_t * x_row = x + row * bx / 4;
+        int32x4_t acc0 = vdupq_n_s32(0);
+        int32x4_t acc1 = vdupq_n_s32(0);
+        int32x4_t acc2 = vdupq_n_s32(0);
+        int32x4_t acc3 = vdupq_n_s32(0);
+
+        for (int i = 0; i < nb; i++) {
+            const uint8_t * px = x_row + i * 32;
+            const int8_t  * py = y + i * 128;
+            const uint8x16_t q0 = vld1q_u8(px);
+            const uint8x16_t q1 = vld1q_u8(px + 16);
+
+            acc0 = ggml_vdotq_s32(acc0, vreinterpretq_s8_u8(vshrq_n_u8(q0, 6)),               vld1q_s8(py +   0));
+            acc1 = ggml_vdotq_s32(acc1, vreinterpretq_s8_u8(vshrq_n_u8(q1, 6)),               vld1q_s8(py +  16));
+            acc2 = ggml_vdotq_s32(acc2, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(q0, 4), mask)), vld1q_s8(py +  32));
+            acc3 = ggml_vdotq_s32(acc3, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(q1, 4), mask)), vld1q_s8(py +  48));
+            acc0 = ggml_vdotq_s32(acc0, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(q0, 2), mask)), vld1q_s8(py +  64));
+            acc1 = ggml_vdotq_s32(acc1, vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(q1, 2), mask)), vld1q_s8(py +  80));
+            acc2 = ggml_vdotq_s32(acc2, vreinterpretq_s8_u8(vandq_u8(q0, mask)),               vld1q_s8(py +  96));
+            acc3 = ggml_vdotq_s32(acc3, vreinterpretq_s8_u8(vandq_u8(q1, mask)),               vld1q_s8(py + 112));
+        }
+
+        int32_t sumi = vaddvq_s32(vaddq_s32(vaddq_s32(acc0, acc1), vaddq_s32(acc2, acc3)));
+        sumi += ggml_i2s_tail_dot(x_row, y, n);
+        s[row] = (float)sumi;
+    }
