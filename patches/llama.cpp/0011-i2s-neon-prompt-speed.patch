+// 4 weight rows x 4 activation columns per tile, for column counts that are not a multiple of 8.
+static void ggml_gemm_i2_i8_s_neon_4x4(int n, float * GGML_RESTRICT s, size_t bs, const uint8_t * GGML_RESTRICT x,
+                                       const int8_t * GGML_RESTRICT y, int nr, int nc) {
+    const int64_t a_row_bytes = n / 4;
+    const int64_t nb = n / 128;
+
+    int64_t r = 0;
+    for (; r + 4 <= nc; r += 4) {
+        int64_t c = 0;
+        for (; c + 4 <= nr; c += 4) {
+            int32x4_t acc[4][4];
+            for (int i = 0; i < 4; i++)
+                for (int j = 0; j < 4; j++)
+                    acc[i][j] = vdupq_n_s32(0);
+
+            for (int64_t bl = 0; bl < nb; bl++) {
+                for (int h = 0; h < 2; h++) {
+                    uint8x16_t q[4];
+                    for (int i = 0; i < 4; i++)
+                        q[i] = vld1q_u8(x + (r + i) * a_row_bytes + bl * 32 + h * 16);
+
+                    for (int p = 0; p < 4; p++) {
+                        int8x16_t a[4];
+                        for (int i = 0; i < 4; i++)
+                            a[i] = i2s_plane(q[i], p);
+
+                        for (int j = 0; j < 4; j++) {
+                            const int8x16_t b = vld1q_s8(y + (c + j) * n + bl * 128 + p * 32 + h * 16);
+                            for (int i = 0; i < 4; i++)
+                                acc[i][j] = ggml_vdotq_s32(acc[i][j], a[i], b);
+                        }
+                    }
+                }
+            }
+
+            for (int i = 0; i < 4; i++)
+                for (int j = 0; j < 4; j++)
+                    s[(c + j) * bs + (r + i)] = (float)vaddvq_s32(acc[i][j]);
+        }
+
+        // the tiles above only cover whole 128-element blocks; add the tail for these 4 rows
+        if (n % 128 != 0) {
+            for (int i = 0; i < 4; i++) {
+                for (int64_t col = 0; col < c; col++) {
+                    s[col * bs + (r + i)] += (float)ggml_i2s_tail_dot(x + (r + i) * a_row_bytes, y + col * n, n);
+                }
+            }
+        }
+
+        // remaining B columns (< 4); ggml_vec_dot_i2_i8_s adds the tail itself
+        for (; c < nr; c++) {
+            for (int i = 0; i < 4; i++) {
+                ggml_vec_dot_i2_i8_s(n, s + c * bs + r + i, 1, x + (r + i) * a_row_bytes, n, y + c * n, 0, 1);
+            }
+        }
+    }
+
+    // remaining A rows (< 4)
+    for (; r < nc; r++) {
+        for (int64_t c = 0; c < nr; c++) {
+            ggml_vec_dot_i2_i8_s(n, s + c * bs + r, 1, x + r * a_row_bytes, n, y + c * n, 0, 1);
+        }
+    }
 }
