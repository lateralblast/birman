+#if defined(__ARM_NEON) && !defined(__AVX2__)
+// NEON I2_S tiles. A 128-element block is two 16-byte halves of 4 bit-planes (see ggml_vec_dot_i2_i8_s):
+// plane p (>> 6, >> 4, >> 2, >> 0) of half h holds elements p*32 + h*16 .. +15, codes 0-2.
+static inline int8x16_t i2s_plane(uint8x16_t q, int p) {
+    const uint8x16_t mask = vdupq_n_u8(0x03);
+    switch (p) {
+        case 0:  return vreinterpretq_s8_u8(vshrq_n_u8(q, 6));
+        case 1:  return vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(q, 4), mask));
+        case 2:  return vreinterpretq_s8_u8(vandq_u8(vshrq_n_u8(q, 2), mask));
+        default: return vreinterpretq_s8_u8(vandq_u8(q, mask));
+    }
+}
+
+// 2 weight rows x 8 activation columns per tile: each unpacked weight vector feeds 8 sdots, and the
+// 16 accumulators, 2 packed rows, 2 unpacked planes and the activation vector fit in the 32 registers.
+// nr must be a multiple of 8; a last odd row goes through vec_dot.
+static void ggml_gemm_i2_i8_s_neon_2x8(int n, float * GGML_RESTRICT s, size_t bs, const uint8_t * GGML_RESTRICT x,
+                                       const int8_t * GGML_RESTRICT y, int nr, int nc) {
+    const int64_t a_row_bytes = n / 4;
+    const int64_t nb = n / 128;
+
+    int64_t r = 0;
+    for (; r + 2 <= nc; r += 2) {
+        const uint8_t * x0 = x + (r + 0) * a_row_bytes;
+        const uint8_t * x1 = x + (r + 1) * a_row_bytes;
+        for (int64_t c = 0; c < nr; c += 8) {
+            const int8_t * yc = y + c * n;
+            int32x4_t acc0[8], acc1[8];
+            for (int j = 0; j < 8; j++) {
+                acc0[j] = vdupq_n_s32(0);
+                acc1[j] = vdupq_n_s32(0);
+            }
+
+            for (int64_t bl = 0; bl < nb; bl++) {
+                for (int h = 0; h < 2; h++) {
+                    const uint8x16_t q0 = vld1q_u8(x0 + bl * 32 + h * 16);
+                    const uint8x16_t q1 = vld1q_u8(x1 + bl * 32 + h * 16);
+                    for (int p = 0; p < 4; p++) {
+                        const int8x16_t a0 = i2s_plane(q0, p);
+                        const int8x16_t a1 = i2s_plane(q1, p);
+                        const int8_t * yb = yc + bl * 128 + p * 32 + h * 16;
+                        for (int j = 0; j < 8; j++) {
+                            const int8x16_t b = vld1q_s8(yb + j * n);
+                            acc0[j] = ggml_vdotq_s32(acc0[j], a0, b);
+                            acc1[j] = ggml_vdotq_s32(acc1[j], a1, b);
+                        }
+                    }
+                }
+            }
+
+            for (int j = 0; j < 8; j++) {
+                int32_t s0 = vaddvq_s32(acc0[j]);
+                int32_t s1 = vaddvq_s32(acc1[j]);
+                if (n % 128 != 0) {
+                    s0 += ggml_i2s_tail_dot(x0, yc + j * n, n);
+                    s1 += ggml_i2s_tail_dot(x1, yc + j * n, n);
+                }
+                s[(c + j) * bs + r + 0] = (float)s0;
+                s[(c + j) * bs + r + 1] = (float)s1;
+            }
+        }
+    }
+
+    for (; r < nc; r++) {
+        for (int64_t c = 0; c < nr; c++) {
+            ggml_vec_dot_i2_i8_s(n, s + c * bs + r, 1, x + r * a_row_bytes, n, y + c * n, 0, 1);
+        }
+    }
+}
